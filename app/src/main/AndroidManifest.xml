        android:supportsRtl="true"
        android:theme="@style/Theme.DeviceFakerNeo">

        <!-- LSPosed / Xposed Module Metadata -->
        <meta-data
            android:name="xposedmodule"
            android:value="true" />
        <meta-data
            android:name="xposeddescription"
            android:value="DeviceFaker Neo - Modern Per-App &amp; Multi-App Device Spoofer (Android 12-15)" />
        <meta-data
            android:name="xposedminversion"
